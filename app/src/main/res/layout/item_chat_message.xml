<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical">

    <!-- User Message Bubble (Left/User-aligned as in Mockup) -->
    <LinearLayout
        android:id="@+id/userBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bubble_user"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/userMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remind me about Emma's school trip."
            android:textColor="@color/chatTextUser"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- AI Assistant Bubble (Right/Teal-aligned as in Mockup) -->
    <LinearLayout
        android:id="@+id/aiBubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bubble_ai"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/aiMessageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Got it! School trip is on April 14th."
            android:textColor="@color/chatTextAi"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
