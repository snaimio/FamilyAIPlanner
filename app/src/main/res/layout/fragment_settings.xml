<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgMint">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/settingsTopBar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnSettingsBack"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Settings &amp; Preferences"
            android:textColor="@color/textPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Account Profile Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_rounded_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/tile_icon_circle"
                    android:contentDescription="Profile avatar"
                    android:padding="10dp"
                    android:src="@drawable/ic_profile" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settingsUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Owner"
                        android:textColor="@color/textPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settingsUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="user@gmail.com"
                        android:textColor="@color/textSecondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSettingsSignOut"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="@color/tileTealLight"
                    android:text="Sign Out"
                    android:textColor="@color/primaryTeal"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <!-- 2. Meal & Dietary Preferences Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="🍽️ Meal &amp; AI Dietary Goals"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:text="Tailor AI meal recommendations to your household diet:"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupDiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBalanced"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Balanced &amp; Healthy"
                    app:chipBackgroundColor="@color/tileTealLight"
                    app:chipStrokeColor="@color/primaryTeal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipQuick"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Quick 30-Min Meals"
                    app:chipBackgroundColor="@color/tileTealLight"
                    app:chipStrokeColor="@color/primaryTeal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipKidFriendly"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kid Friendly 👶"
                    app:chipBackgroundColor="@color/surfaceWhite"
                    app:chipStrokeColor="@color/borderSoft" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipVegetarian"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vegetarian 🥗"
                    app:chipBackgroundColor="@color/surfaceWhite"
                    app:chipStrokeColor="@color/borderSoft" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipHighProtein"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High Protein 💪"
                    app:chipBackgroundColor="@color/surfaceWhite"
                    app:chipStrokeColor="@color/borderSoft" />

            </com.google.android.material.chip.ChipGroup>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/borderSoft" />

            <!-- 3. Smart Notifications Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔔 Smart Reminders &amp; Alerts"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchMorningBriefing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Morning Agenda Briefing (8:00 AM)"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                app:thumbTint="@color/primaryTeal"
                app:trackTint="@color/tileTealLight" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchGroceryAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Live Grocery Item Sync"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                app:thumbTint="@color/primaryTeal"
                app:trackTint="@color/tileTealLight" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchAppointmentReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Family Calendar Event Alerts"
                android:textColor="@color/textPrimary"
                android:textSize="14sp"
                app:thumbTint="@color/primaryTeal"
                app:trackTint="@color/tileTealLight" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="@color/borderSoft" />

            <!-- 4. Google Gemini AI API Key Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤖 Custom Gemini AI API Key (Optional)"
                android:textColor="@color/textPrimary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:text="Enter a Google AI Studio API key for unlimited AI conversational features:"
                android:textColor="@color/textSecondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputGeminiApiKey"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/item_card_bg"
                    android:hint="AIzaSy..."
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/textPrimary"
                    android:textColorHint="@color/textMuted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSaveApiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_teal_rounded"
                    android:text="Save"
                    android:textColor="@color/textWhite"
                    android:textSize="13sp"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
